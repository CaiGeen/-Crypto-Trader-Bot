+def _format_partial_candidates(all_states, net_pos_fn):
+    """🔥 v6.4-P1（Fix 3）：/partial 无参时列出可减仓批次——纯本地 durable state，零 API。
+
+    只列 is_active、净持仓 > 0 且未冻结（close_phase==0 且非 pending_close）的批次——
+    冻结批次当前无法 /partial，净 0 ghost（entry 未成交骨架）列出来只会干扰选批。"""
+    lines = []
+    for symbol, symbol_batches in (all_states or {}).items():
+        if not isinstance(symbol_batches, dict):
+            continue
+        for batch_id, b in symbol_batches.items():
+            if not isinstance(b, dict) or not b.get('is_active'):
+                continue
+            if int(b.get('close_phase', 0) or 0) >= 1 or b.get('pending_close'):
+                continue
+            try:
+                net_qty, _net_cost = net_pos_fn(b)
+            except Exception:
+                continue
+            if not net_qty or net_qty <= 0:
+                continue
+            hhmmss = ''
+            parts = str(batch_id).split('_')
+            if len(parts) >= 3 and len(parts[2]) == 6 and parts[2].isdigit():
+                hhmmss = f"{parts[2][0:2]}:{parts[2][2:4]}:{parts[2][4:6]}"
+            lines.append(
+                f"🕒 {hhmmss} | {symbol} | {str(b.get('side') or '?').upper()} | 净持仓 {net_qty}\n"
+                f"`{batch_id}`\n"
+                f"`/partial {batch_id} <数量>`")
+    if not lines:
+        return "📋 当前无可减仓批次（净持仓 > 0 且未冻结的活跃批次为空）。"
+    return ("❌ 格式错误！正确格式：`/partial <BatchID> <数量>`\n"
+            "📋 可减仓批次（净持仓 > 0）：\n\n" + "\n\n".join(lines))
+
+
