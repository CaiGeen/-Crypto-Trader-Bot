+    def _maybe_runtime_finalize_limit(self, symbol, batch_id, close_op_id):
+        """🔥 P5c（ChatGPT 二复审 Blocker 3）：monitor 冻结分支的 phase=2 finalizer
+        运行期接管调度（60s 节流，与 partial 自愈共用状态簿记）。
