+        if ok_r:
+            self._partial_resume_state.pop(batch_id, None)
+            print(f"  └─ ✅ [限价结算接管] 批次 {batch_id}: {msg_r}")
+            return
+        if msg_r == 'resize_inflight':
+            self._partial_resume_state[batch_id] = _prs
+            return
+        _prs['fails'] = int(_prs.get('fails', 0) or 0) + 1
