+        lambda **kk: created.append(kk) or {'id': 'Y'})
+    f._poll_degraded_batches.discard('batch_new_001')
+    CryptoTrader.execute_signal(f, sig)
+    time.sleep(0.3)
+    report('B26a3 闸门在位时新 ENTRY 创建被阻断',
+           len(created) == 0, f'本轮 create 调用={len(created)}（应 0）')
