+    # ④ 此时再实际发起 ENTRY：必须被拦住，不得落 create_order
+    f.exchange.create_order.side_effect = None
+    f.exchange.create_order.side_effect = _create
+    ret = CryptoTrader.execute_signal(f, sig)
