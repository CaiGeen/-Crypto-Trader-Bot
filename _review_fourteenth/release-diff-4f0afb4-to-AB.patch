+def _two_layer_fake():
+    class _TwoLayerSignal(_FakeSignal):
+        def __init__(self):
+            super().__init__()
+            self.entries = [(77000.0, 0.43), (78000.0, 0.43)]
+            self.stop_loss_steps = [75000.0, 76000.0]
