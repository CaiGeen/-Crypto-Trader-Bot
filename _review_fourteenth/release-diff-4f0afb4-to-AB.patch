+        # ???????????????????????????
+        fake.load_all_states = lambda: {s: {b: dict(v) for b, v in m.items()}
+                                        for s, m in states.items()}
+        life = _takeover_lifecycle(fake, "gen-s6k")
+        fake.exchange.fetch_open_orders.return_value = [
