+    ret2 = CryptoTrader.execute_signal(f, sig)
+    time.sleep(0.1)
+    report('B33e 阳性对照：重新放闸后同一 ENTRY 确实能落单（证明④不是假绿）',
+           life2['handoff_event'].is_set() and len(created) >= 1,
+           f'handoff={life2["handoff_event"].is_set()}，ret2={ret2!r}，'
