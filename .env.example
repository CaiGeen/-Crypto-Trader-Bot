# ============ 必填：Binance API（永续合约权限，仅交易权限即可） ============
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# ============ 可选：代理（Binance 需要海外网络时配置） ============
# 格式: http://127.0.0.1:7890
BINANCE_PROXY=

# ============ 必填：Telegram Bot ============
# 通过 @BotFather 创建机器人获取 Token
TG_BOT_TOKEN=your_telegram_bot_token
# 允许操作机器人的用户 ID（在 @userinfobot 查询）
TG_ALLOWED_USER_ID=your_telegram_user_id

# ============ 可选：风控参数 ============
MAX_LEVERAGE=20
IP_CHECK_ENABLED=true

# ============ 可选：邮件告警（QQ 邮箱） ============
QQ_MAIL_USER=
QQ_MAIL_AUTH_CODE=
QQ_MAIL_TO=
# 邮件总手动开关（true=允许发送，false=禁止所有邮件；不影响 Telegram）
EMAIL_ALERT_ENABLED=true
# 仅在 trade_state.json 存在 is_active=true 的活跃批次时发送邮件。
# 状态文件缺失/损坏时按“无持仓”处理（不发邮件）；不影响 Telegram。
# ⚠️ R0 起仅作用于**普通事件**；资金安全事件（critical / AUTH_BLOCKED / 崩溃 /
#    Watchdog 启动熔断 / 健康巡检）与每日结算报告**豁免**本闸门。
EMAIL_ALERT_ONLY_WITH_POSITION=false
# 每日结算报告邮件独立开关（true=每天 08:05 照发，即使空仓；false=只发 Telegram）
DAILY_REPORT_EMAIL_ENABLED=true
